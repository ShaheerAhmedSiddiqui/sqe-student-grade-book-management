{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "rollNo", "scores", "average", "grade"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "pattern": ".*[A-Za-z].*" },
    "rollNo": { "type": "integer", "minimum": 1 },
    "scores": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "number", "minimum": 0, "maximum": 100 } },
    "average": { "type": "number", "minimum": 0, "maximum": 100 },
    "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] }
  }
}
